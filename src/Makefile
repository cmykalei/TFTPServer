# Makefile for Java Project

JAVAC = javac
JAVA = java
SRC_DIR = src

# Default target to compile the project
all: compile

# Compile all Java files in the src directory
compile:
	$(JAVAC) *.java

# Run the project (replace 'TftpServer' with your main class name)
run:
	$(JAVA) TftpServer

# Clean compiled files
clean:
	rm -f *.class
	@echo "Clean complete."
	ls
